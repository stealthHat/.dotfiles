#!/bin/bash

outputs=$(xrandr)

if grep -q '^DP-1-1-5 connected' <<<"${outputs}"; then
  xrandr --auto --output eDP-1 --primary --auto \
    --output DP-1-1-5 --above eDP-1 --mode 2560x1440 --rate 59.95 --set "Broadcast RGB" "Full"
else
  xrandr --auto --output eDP-1 --primary --auto
fi

xwallpaper --center "${HOME}/git/.dotfiles/home/.config/wallpapers/wpezyRn.jpeg"
