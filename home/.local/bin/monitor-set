#!/bin/bash

intern=eDP-1
#extern=HDMI-1
extern=DP-1-1-5

paper() {
  xwallpaper --center "$HOME/git/.dotfiles/home/.config/wallpapers/wpezyRn.jpeg"
}

stale=$(xrandr | awk '/ disconnected (primary )?[0-9]/ {printf "--output %s --off ", $1}')

if xrandr | grep "$extern disconnected"; then
  xrandr --output "$extern" --off
  paper
else
  xrandr $stale --output "$intern" --primary --auto \
    --output "$extern" --above "$intern" \
    --mode 2560x1440 --rate 59.95 \
    --set "Broadcast RGB" "Full"
  #  xrandr --output "$intern" --primary --auto \
  #    --output "$extern" --above "$intern" --auto \
  #    --set "Broadcast RGB" "Full"
  paper
fi
