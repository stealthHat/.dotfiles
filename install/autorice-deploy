#!/bin/bash
set -eo pipefail

readonly root_dir=$(git rev-parse --show-toplevel)
readonly script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly git_dir="${root_dir%/*}"

__pkg_install() {
  printf "Installing %s\n" "$1: $2"
  sudo pacman --noconfirm --needed -S "$1"
}

__repo_install() {
  local repname="${1##*/}"
  if [[ ! -d "${git_dir}/${repname}" ]]; then
    printf "Cloning and building %s\n" "$1: $2"
    (
      git clone --quiet --depth 1 "$1" "${git_dir}/${repname}" >/dev/null
      cd "${git_dir}/${repname}"
      sudo make clean install >/dev/null 2>&1
    )
  fi
}

# shellcheck disable=SC2035
setup_links() {
  (
    printf "Folders and symbolic links\n"
    shopt -s dotglob
    cd "${root_dir}/home"
    find * -type d -exec mkdir -pv "${HOME}/{}" \;
    find * -type f -exec ln -sfv "${PWD}/{}" "${HOME}/{}" \;
    find . -type d -exec find "${HOME}/{}" -maxdepth 1 -xtype l -lname "${root_dir}/home/*" -print -delete \;

    cd "${script_dir}"
    sudo find etc/ -type d -exec mkdir -pv /{} \;
    sudo find etc/ -type f -exec ln -sfv "${PWD}/{}" "/{}" \;
  )
}

mirror_update() {
  printf "Mirrors update\n"
  sudo pacman --noconfirm -Syu reflector
  sudo reflector --country Brazil,Chile --protocol https --sort rate --save /etc/pacman.d/mirrorlist || true
}

install_loop() {
  printf "Installing packages from packages folder\n"
  source "${root_dir}/home/.zprofile"

  for csv in "${script_dir}"/packages/*.csv; do
    while IFS=, read -r tag program comment; do
      [[ "${tag}" =~ ^#.*$ ]] && continue
      case "${tag}" in
        "G") __repo_install "${program}" "${comment}" ;;
        *) __pkg_install "${program}" "${comment}" ;;
      esac
    done <"${csv}"
  done

  printf "Installing mise tools\n"
  mise install --locked
}

basic_config() {
  printf "Creating Home folders\n"
  xdg-user-dirs-update

  printf "Set zsh as the default shell\n"
  local shell=$(command -v zsh)
  local user=$(whoami)
  sudo chsh -s "${shell}" "${user}"

  printf "Pacman config\n"
  grep -q "ILoveCandy" /etc/pacman.conf || sudo sed -i "/VerbosePkgLists/a ILoveCandy" /etc/pacman.conf
  sudo sed -i '/Color/ s/^#//; /VerbosePkgLists/ s/^#//; /ParallelDownloads/ s/^#//' /etc/pacman.conf
}

clean_up() {
  printf "Cleaning Up\n"
  cd "${HOME}"
  rm -rf .bash* .mkshrc .profile .zcompdump* .zlogin .zshrc .zsh_history .Xauthority >/dev/null
  sudo reboot now
}

case "$1" in
  links)
    setup_links
    ;;
  fresh)
    setup_links
    mirror_update
    install_loop
    basic_config
    clean_up
    ;;
  install)
    install_loop
    ;;
  "") printf ":: autorice needs a argument ::\n" ;;
  *) printf ":: Invalid option: %s ::\n" "$1" ;;
esac
